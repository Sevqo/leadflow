# Browser-safe application configuration
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional first-party reverse-proxy URL shown to connector owners instead of provider infrastructure.
VITE_PUBLIC_INGEST_URL=
# Set true only after a supported payment provider is configured and live checkout is verified.
VITE_BILLING_PROVIDER_READY=false

# Server-only secrets — never add a VITE_ prefix or expose these to the browser
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
RESEND_API_KEY=
